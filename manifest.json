{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "service-notes",
  "color": "#f59e0b",
  "name": { "de": "Dienst-Notizen", "en": "Service notes" },
  "description": { "de": "Notizen und Checklisten zu jedem Dienst – als eigener Reiter auf jeder Detailseite (Webserver, Datenbank, Minecraft, App, Spiele-Server) und im Rechtsklick-Menü.", "en": "Notes and checklists for every service – as its own tab on every detail page (web server, database, Minecraft, app, game server) and in the right-click menu." },
  "permissions": ["read:services", "storage"],
  "page": {
    "title": { "de": "Notizen", "en": "Notes" },
    "description": { "de": "Alle Notizen zu deinen Diensten – mit Suche und abhakbaren Checklisten.", "en": "All notes about your services – with search and checklists you can tick off." },
    "icon": "file",
    "file": "page/index.html"
  },
  "contributes": {
    "tabs": [
      { "id": "notes-web", "title": { "de": "Notizen", "en": "Notes" }, "icon": "file", "on": "web", "file": "page/tab.html" },
      { "id": "notes-db", "title": { "de": "Notizen", "en": "Notes" }, "icon": "file", "on": "db", "file": "page/tab.html" },
      { "id": "notes-mc", "title": { "de": "Notizen", "en": "Notes" }, "icon": "file", "on": "minecraft", "file": "page/tab.html" },
      { "id": "notes-app", "title": { "de": "Notizen", "en": "Notes" }, "icon": "file", "on": "app", "file": "page/tab.html" },
      { "id": "notes-game", "title": { "de": "Notizen", "en": "Notes" }, "icon": "file", "on": "game", "file": "page/tab.html" }
    ],
    "actions": [
      { "id": "note", "title": { "de": "Notiz …", "en": "Note …" }, "icon": "file", "on": ["web", "db", "minecraft", "app", "game"] },
      { "id": "all", "title": { "de": "Alle Notizen", "en": "All notes" }, "icon": "file", "on": ["palette"] }
    ]
  },
  "version": "1.0.0",
  "author": "Hostwerk",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-service-notes",
  "license": "MIT",
  "icon": "icon.svg",
  "hostwerk": ">=2.9.0"
}
